rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // User profile pictures
    match /users/{userId}/{fileName} {
      allow read: if true; // Public read access
      allow write: if isOwner(userId);
    }
    
    // Product images
    match /products/{productId}/{fileName} {
      allow read: if true; // Public read access
      allow write: if isAdmin();
    }
    
    // Trade-in images
    match /tradeIns/{tradeInId}/{fileName} {
      allow read: if isOwner(get(/databases/$(database)/documents/tradeIns/$(tradeInId)).data.userId) || isAdmin();
      allow write: if isOwner(get(/databases/$(database)/documents/tradeIns/$(tradeInId)).data.userId) || isAdmin();
    }
    
    // Device model images
    match /devices/{deviceId}/{fileName} {
      allow read: if true; // Public read access
      allow write: if isAdmin();
    }
    
    // Order-related images (receipts, etc.)
    match /orders/{orderId}/{fileName} {
      allow read: if isOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.userId) || isAdmin();
      allow write: if isOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.userId) || isAdmin();
    }
    
    // General uploads (restricted)
    match /uploads/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && 
                      request.resource.size < 5 * 1024 * 1024 && // 5MB limit
                      request.resource.contentType.matches('image/.*');
    }
    
    // Default rule: deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
